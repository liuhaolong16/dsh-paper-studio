[
  {
    "name": "paper_studio",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "modes",
            "intent",
            "route",
            "gates",
            "intake",
            "draft",
            "scaffold",
            "genre",
            "sections",
            "verify",
            "stylecheck",
            "polish",
            "revise",
            "figures",
            "profile",
            "coach",
            "audit",
            "state",
            "lessons",
            "method",
            "handoff",
            "crosscheck",
            "docx",
            "selftest"
          ],
          "description": "要执行的动作；modes 返回模式菜单，intent 判意图（需 text），其余桥接到 CLI 同名子命令"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "原样追加给 CLI 的参数（如 [\"--file\",\"稿.md\",\"--genre\",\"research\"]），不经过再解释"
        },
        "cwd": {
          "type": "string",
          "description": "CLI 的工作目录（默认 = paper-studio 根）；稿件在别处时传它，便于相对路径"
        },
        "text": {
          "type": "string",
          "description": "action=intent 时要判定的用户原话"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "paper_dev",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "list",
            "read",
            "write",
            "unlock",
            "seal"
          ],
          "description": "要执行的动作"
        },
        "path": {
          "type": "string",
          "description": "相对 paper-studio 根的资产路径（read/write 用），如 \"references/pipeline.json\""
        },
        "content": {
          "type": "string",
          "description": "写入内容（write 用）"
        },
        "phrase": {
          "type": "string",
          "description": "用户原话（unlock 用）；必须与约定话术一致才解锁"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  }
]
